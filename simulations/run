#!/usr/bin/env bash
set -euo pipefail

SIMULATION_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SIMULATION_DIR/.." && pwd)"
if [[ -f "$PROJECT_DIR/.env" ]]; then
    set -a
    source "$PROJECT_DIR/.env"
    set +a
fi
: "${WORKSPACE:=$(cd "$PROJECT_DIR/.." && pwd)}"
: "${INET_VERSION:=inet-4.5.4}"

cd "$SIMULATION_DIR"
exec "$PROJECT_DIR/src/sistema_dbg" \
    -n "$SIMULATION_DIR:$PROJECT_DIR/src:$WORKSPACE/$INET_VERSION/src" "$@"
